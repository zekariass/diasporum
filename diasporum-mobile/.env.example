# Diasporum Mobile — environment template (committed, no secrets).
# Copy to .env and fill in values for your environment.
# All EXPO_PUBLIC_* variables are inlined into the app bundle at build time —
# treat every value here as public/client-safe. Never put secrets or passwords here.

# Application environment (development | staging | production)
EXPO_PUBLIC_APP_ENV=development

# Diasporum backend base URL (no trailing slash)
# Local dev (Android emulator): http://10.0.2.2:8080
# Local dev (iOS simulator / physical device on same network): http://localhost:8080
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Keycloak configuration
# Local dev: http://localhost:8081 (iOS/desktop)
# Local dev (Android emulator): http://10.0.2.2:8081
EXPO_PUBLIC_KEYCLOAK_URL=http://localhost:8081
EXPO_PUBLIC_KEYCLOAK_REALM=diasporum
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=diasporum-mobile

# OAuth redirect URI — must be registered in Keycloak (diasporummobile://* is registered)
EXPO_PUBLIC_AUTH_REDIRECT_URI=diasporummobile://callback

# Realtime messaging (Ably) — no client-side secret is ever configured here.
# The app fetches a short-lived Ably token request from
#   POST {EXPO_PUBLIC_API_BASE_URL}/api/v1/realtime/token
# using the existing authenticated session, and subscribes only to its own
# user channel. If realtime is disabled on the backend, the messaging UI
# keeps working over REST alone.
