# Diasporum backend — local development environment template.
# Copy to .env (same directory) and fill in local values.
# .env is gitignored; this template IS committed. NEVER commit a real .env
# or any private keys/secrets.

# --- PostgreSQL (Compose-managed local instance) ---
DIASPORUM_DB_NAME=diasporum_dev_v10_12
DIASPORUM_DB_USERNAME=diasporum
DIASPORUM_DB_PASSWORD=change-me-locally
# Host port; 5433 avoids the native PostgreSQL service already on 5432.
DIASPORUM_DB_PORT=5433
DIASPORUM_DB_URL=jdbc:postgresql://localhost:5433/diasporum_dev_v10_12

# --- Diasporum JWT signing (first-party RS256 auth) ---
# Local dev may run WITHOUT keys: the local profile generates an ephemeral
# pair per boot (all sessions die on restart). Staging/prod MUST set both —
# generate a pair with:
#   openssl genrsa -out jwt-private.pem 4096
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
# The backend validates the pair matches at startup and fails fast otherwise.
DIASPORUM_JWT_ISSUER=https://api.diasporum.local
DIASPORUM_JWT_AUDIENCE=diasporum-api
DIASPORUM_JWT_KID=local-1
DIASPORUM_JWT_PRIVATE_KEY=
DIASPORUM_JWT_PUBLIC_KEY=
# Keep false outside local dev — a missing-key deployment must fail, not
# silently sign with disposable keys.
DIASPORUM_JWT_ALLOW_EPHEMERAL_KEYS=false
DIASPORUM_ACCESS_TOKEN_TTL=PT15M
DIASPORUM_REFRESH_TOKEN_TTL=P30D
DIASPORUM_SESSION_TTL=P90D

# --- Email delivery ---
# local = log-only delivery (dev/tests). smtp = real delivery via spring.mail.
# Production MUST use smtp — any other value means no EmailService bean and
# the backend refuses to start.
DIASPORUM_MAIL_PROVIDER=local
DIASPORUM_MAIL_FROM=no-reply@diasporum.local
# Public base URL embedded in verification/reset links.
DIASPORUM_APP_BASE_URL=https://app.diasporum.local
# SMTP (required only when DIASPORUM_MAIL_PROVIDER=smtp)
DIASPORUM_SMTP_HOST=
DIASPORUM_SMTP_PORT=587
DIASPORUM_SMTP_USERNAME=
DIASPORUM_SMTP_PASSWORD=
DIASPORUM_SMTP_AUTH=true
DIASPORUM_SMTP_STARTTLS=true
DIASPORUM_SMTP_STARTTLS_REQUIRED=true
# Set true only for implicit-SSL providers on port 465.
DIASPORUM_SMTP_SSL=false

# --- CORS (browser-facing origins; native mobile is unaffected) ---
# Comma-separated; empty = no cross-origin browser access.
# The local profile defaults to http://localhost:3000,8081,19006.
DIASPORUM_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# --- External identity providers (sign-in verification only) ---
# Google: comma-separated OAuth client IDs (Android/iOS/web) for this project.
DIASPORUM_GOOGLE_CLIENT_IDS=
# Apple: Services ID / client identifier used as the token audience.
DIASPORUM_APPLE_CLIENT_ID=

# --- Cloudflare R2 (media storage) — DISABLED by default ---
# The storage adapter only activates when R2_ENABLED=true AND all four
# endpoint/bucket/key values below are non-empty.
R2_ENABLED=false
CLOUDFLARE_R2_ACCOUNT_ID=
# Endpoint form: https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
R2_UPLOAD_URL_TTL=PT15M
R2_DOWNLOAD_URL_TTL=PT2M
R2_UPLOAD_SESSION_TTL=PT15M
# 25 MiB = 26214400 bytes (approved limit)
R2_MAX_UPLOAD_BYTES=26214400
