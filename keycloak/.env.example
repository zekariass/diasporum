# Keycloak — local development environment template (committed).
# Copy to .env in this directory. Contains ONLY Keycloak service variables.
# Never commit a real .env or credentials.

KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-locally

KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=change-me-locally

KC_HOSTNAME=http://localhost:8081
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=false
