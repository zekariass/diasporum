# Diasporum web — environment template (committed).
# Copy to .env.local. Server-side vars have no prefix; NEXT_PUBLIC_* is public.
# Never put database credentials or service secrets in NEXT_PUBLIC_*.

API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Keycloak confidential client (BFF) — server-side only, never in NEXT_PUBLIC_*
KEYCLOAK_ISSUER=http://localhost:8081/realms/diasporum
KEYCLOAK_CLIENT_ID=diasporum-web
KEYCLOAK_CLIENT_SECRET=
